module register_file_tb;

    reg clk;
    reg reset;
    reg [1:0] read_addr1;
    reg [1:0] read_addr2;
    reg [1:0] write_addr;
    reg [3:0] write_data;
    reg reg_write;

    wire [3:0] read_data1;
    wire [3:0] read_data2;

    integer i;

    register_file dut (
        .clk(clk),
        .reset(reset),
        .read_addr1(read_addr1),
        .read_addr2(read_addr2),
        .write_addr(write_addr),
        .write_data(write_data),
        .reg_write(reg_write),
        .read_data1(read_data1),
        .read_data2(read_data2)
    );

    // ????? ??????
    always #5 clk = ~clk;

    // ???? ?????? ???? ?? ???
    task write_register;
        input [1:0] addr;
        input [3:0] data;
        begin
            @(negedge clk);
            write_addr = addr;
            write_data = data;
            reg_write = 1;

            @(posedge clk);
            #1;
            reg_write = 0;
        end
    endtask

    initial begin
        clk = 0;
        reset = 1;
        reg_write = 0;
        read_addr1 = 0;
        read_addr2 = 0;
        write_addr = 0;
        write_data = 0;

        // ???? ???reset
        repeat (2) @(posedge clk);
        #1;
        reset = 0;

        // ????? ?? ??????? ??????? ???? ?? ???
        for (i = 0; i < 4; i = i + 1) begin
            read_addr1 = i;
            #1;
            if (read_data1 !== 4'b0000) begin
                $display("FAIL: reset, register %0d = %b",
                         i, read_data1);
                $finish;
            end
        end
        $display("PASS: reset ???? ??????? ???????");

        // ???? ???? ?????? ?? ?? ???
        write_register(2'b00, 4'b1010);
        write_register(2'b01, 4'b0101);
        write_register(2'b10, 4'b1100);
        write_register(2'b11, 4'b0011);

        // ???? ????? ??????? ????
        read_addr1 = 2'b00;
        read_addr2 = 2'b01;
        #1;
        if (read_data1 !== 4'b1010 || read_data2 !== 4'b0101) begin
            $display("FAIL: read reg0=%b reg1=%b",
                     read_data1, read_data2);
            $finish;
        end

        read_addr1 = 2'b10;
        read_addr2 = 2'b11;
        #1;
        if (read_data1 !== 4'b1100 || read_data2 !== 4'b0011) begin
            $display("FAIL: read reg2=%b reg3=%b",
                     read_data1, read_data2);
            $finish;
        end
        $display("PASS: ??????? ???????? ?? ??????? ????");

        // ???? ?? reg_write=0 ???? ???????
        @(negedge clk);
        write_addr = 2'b01;
        write_data = 4'b1111;
        reg_write = 0;

        @(posedge clk);
        #1;
        read_addr1 = 2'b01;
        #1;

        if (read_data1 !== 4'b0101) begin
            $display("FAIL: ??? ??????? ??? ?? reg_write=0");
            $finish;
        end

        $display("PASS: reg_write=0 ??? ???????");
        $display("PASS: ?? ?????? Register File ????");
        $finish;
    end

endmodule